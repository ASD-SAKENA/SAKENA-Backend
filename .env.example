# Production `.env` for the server (git-ignored). Copy values onto the VPS.
# docker-compose.prod.yml overrides DB_URL and MINIO_ENDPOINT for the Docker network.

# --- Database ---
DB_NAME=sakena
DB_USERNAME=sakena
DB_PASSWORD=change-me-strong-db-password

# --- Application ---
SERVER_PORT=8080
LOG_LEVEL_APP=INFO
FRONTEND_URL=http://185.250.249.230:3000

# --- Secrets ---
# Must be >= 32 bytes. Generate: openssl rand -base64 32
JWT_SECRET=tz7Tq6KlSHj4Tx6Teevuk98Eyz9ZrwL1btOCesS2KhU=
JWT_EXPIRATION_MS=86400000

# SMTP (optional until password-reset email is needed)
MAIL_USERNAME=
MAIL_PASSWORD=
APP_RESET_TOKEN_EXPIRATION_MINUTES=60

# --- Administrator account (optional) ---
# Seeded once on startup if all three are set and no such user exists yet.
# This is the only way to create an ADMIN account — public signup rejects it.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- MinIO (started by docker-compose.prod.yml as sakena_minio) ---
# Backend reaches MinIO via compose override: http://sakena_minio:9000
# Browsers / presigned URLs use the public host:port below.
MINIO_PUBLIC_ENDPOINT=http://185.250.249.230:9000
MINIO_ACCESS_KEY=sakena
MINIO_SECRET_KEY=sakena-minio-secret
MINIO_BUCKET=sakena-chat
MINIO_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
